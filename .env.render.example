# ─────────────────────────────────────────────────────────────────────
# Valores ESTABLES del deploy de Render — se reusan cada vez que se
# recrea la base (el Postgres free de Render se borra solo cada ~30 días).
#
# Copiá este archivo a `.env.render` y completá los valores.
# `.env.render` está en .gitignore — NUNCA commitear el real.
#
# Dos formas de recrear la base cuando Render la borre:
#
#   A) Un solo comando, de punta a punta (crea la base + migra + siembra +
#      actualiza las env vars del servicio + redeploya). Requiere
#      RENDER_API_KEY y RENDER_SERVICE_ID (ver abajo):
#        npm run redeploy:render              # vista previa, no toca nada
#        npm run redeploy:render -- --apply   # aplica de verdad
#
#   B) Manual: crear la base a mano en el dashboard de Render (Blueprint
#      re-apply o "New Postgres"), copiar su External Database URL, y:
#        npm run bootstrap:render -- "postgresql://stockpro:...@...render.com/stockpro_xxxx"
#      Esto deja el bloque de env vars impreso para pegar a mano en
#      Render → stockpro-api → Environment.
# ─────────────────────────────────────────────────────────────────────

# ── Solo para la opción A (npm run redeploy:render) ───────────────────
# API Key personal de Render: dashboard.render.com → ícono de cuenta
# (arriba a la derecha) → Account Settings → API Keys → Create API Key.
# Dale a la key el mismo scope de tu cuenta/workspace donde vive stockpro-api.
RENDER_API_KEY=""

# Id del web service `stockpro-api`. Se saca de la URL del servicio en el
# dashboard: dashboard.render.com/web/srv-XXXXXXXXXXXX → "srv-XXXXXXXXXXXX".
RENDER_SERVICE_ID=""

# Opcional — solo si tu API key ve más de un workspace/team en Render y
# el script elige el equivocado (avisa si pasa). Se saca de GET /owners.
RENDER_OWNER_ID=""

# Opcionales — por defecto ya coinciden con render.yaml, tocar solo si
# ese archivo cambió.
RENDER_REGION="virginia"
RENDER_DB_PLAN="free"
RENDER_PG_VERSION="18"
RENDER_DB_DISPLAY_NAME="stockpro-db"

# ── Solo para la opción B (npm run bootstrap:render) ──────────────────
# Lo ÚNICO que cambia al recrear la base a mano: su External Database URL
# nueva (rol dueño `stockpro`). Se saca de Render → recurso Postgres →
# "External Database URL". Se puede pasar como argumento en vez de ponerla acá.
RENDER_DATABASE_URL=""

# Contraseña del rol de aplicación `stockpro_app` (la elegís vos y la reusás
# entre recreaciones). El script hace ALTER ROLE con este valor y arma el
# APP_DATABASE_URL final con él.
STOCKPRO_APP_DB_PASSWORD=""

# PlatformAdmin (SuperAdmin) del panel /admin-saas
PLATFORM_ADMIN_EMAIL="admin@stockpro.dev"
PLATFORM_ADMIN_PASSWORD=""

# Sembrar los tenants demo dlnorte/acme (contraseña pública StockPro2026!).
# "true" en un deploy de pruebas/ventas; "false" en producción real.
SEED_DEMO_TENANTS="true"

# Recordatorio para el bloque de env vars de Render (el script NO lo aplica —
# solo lo imprime): candado de entorno del acceso rápido. "true" en pruebas.
ALLOW_DEMO_LOGIN="true"
