# ─────────────────────────────────────────────────────────────────────
# Valores ESTABLES del deploy de Render — se reusan cada vez que se
# recrea la base (el Postgres free de Render se borra solo cada ~30 días).
#
# Copiá este archivo a `.env.render` y completá los valores.
# `.env.render` está en .gitignore — NUNCA commitear el real.
#
# Uso:  npm run bootstrap:render -- "postgresql://stockpro:...@...render.com/stockpro_xxxx"
#   (o dejá RENDER_DATABASE_URL seteada acá y corré `npm run bootstrap:render`)
# ─────────────────────────────────────────────────────────────────────

# Lo ÚNICO que cambia al recrear la base: su External Database URL nueva
# (rol dueño `stockpro`). Se saca de Render → recurso Postgres → "External
# Database URL". Se puede pasar como argumento en vez de ponerla acá.
RENDER_DATABASE_URL=""

# Contraseña del rol de aplicación `stockpro_app` (la elegís vos y la reusás
# entre recreaciones). El script hace ALTER ROLE con este valor y arma el
# APP_DATABASE_URL final con él.
STOCKPRO_APP_DB_PASSWORD=""

# PlatformAdmin (SuperAdmin) del panel /admin-saas
PLATFORM_ADMIN_EMAIL="admin@stockpro.dev"
PLATFORM_ADMIN_PASSWORD=""

# Sembrar los tenants demo dlnorte/acme (contraseña pública StockPro2026!).
# "true" en un deploy de pruebas/ventas; "false" en producción real.
SEED_DEMO_TENANTS="true"

# Recordatorio para el bloque de env vars de Render (el script NO lo aplica —
# solo lo imprime): candado de entorno del acceso rápido. "true" en pruebas.
ALLOW_DEMO_LOGIN="true"
