# StockPro API
# Copia este archivo a .env y completa los valores reales. Nunca commitear .env real.

# PostgreSQL
# Usado por `prisma migrate` y `prisma:seed` (necesita DDL) — dueño de las tablas.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stockpro?schema=public"

# Usado por la APP en tiempo de ejecución (PrismaService). Debe ser un rol SIN
# superusuario y SIN ser dueño de las tablas, para que Row-Level Security
# aplique de verdad (un superusuario o el dueño de la tabla ignora RLS incondi-
# cionalmente). Crear el rol con:
#   STOCKPRO_APP_DB_PASSWORD=<contraseña-fuerte> npx ts-node prisma/create-app-role.ts
APP_DATABASE_URL="postgresql://stockpro_app:PASSWORD@localhost:5432/stockpro?schema=public"

# JWT — tenant (Fase 1)
JWT_SECRET="cambia-este-valor-en-produccion"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-este-otro-valor-en-produccion"
JWT_REFRESH_EXPIRES_IN="7d"

# JWT — PlatformAdmin (Fase 7d) — SECRETO DISTINTO al de tenant, nunca el mismo valor
ADMIN_JWT_SECRET="cambia-este-valor-tambien-distinto-al-de-arriba"
ADMIN_JWT_EXPIRES_IN="8h"

# JWT — Portal de Clientes (Fase 7e) — SECRETO DISTINTO a los dos anteriores
# Larga duración a propósito: es un link que el cliente guarda/usa repetidamente,
# no una sesión de trabajo corta.
PORTAL_JWT_SECRET="cambia-este-valor-tambien-distinto-a-los-dos-de-arriba"
PORTAL_JWT_EXPIRES_IN="365d"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"
# NODE_ENV="production" en despliegues reales — activa validaciones estrictas
# (CORS sin fallback, y bloquea /auth/demo-login salvo que ALLOW_DEMO_LOGIN=true).
# ALLOW_DEMO_LOGIN="true"

